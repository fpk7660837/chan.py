  "portfolio_backtest": {
    "enabled": true,
    "top_k": 3,
    "score_threshold": 0.55,
    "rebalance_bars": 5,
    "signal_lookback_bars": 20
  },
  "storage": {
    "root_dir": "AutoResearch/results",
    "leaderboard_filename": "leaderboard.md"
  }
}
